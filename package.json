{
  "name": "mspc-attendance",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "build": "npm run build:client && npm run build:api",
    "build:client": "vite build",
    "build:api": "esbuild api/src/index.ts --bundle --platform=node --format=cjs --sourcemap --outfile=api/dist/index.js --external:@azure/functions",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "node -e \"['dist','api/dist'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "smoke": "tsx scripts/smoke.ts",
    "kv-sync": "tsx scripts/kv-sync.ts"
  },
  "dependencies": {
    "@azure/cosmos": "^4.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "moment": "^2.30.1",
    "motion": "^12.23.24",
    "papaparse": "^5.5.3",
    "react": "^19.0.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@azure/functions": "^4.5.1",
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.1",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.0.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^10.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@rollup/rollup-linux-x64-gnu": "4.60.4",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "engines": {
    "node": ">=22.3"
  }
}
